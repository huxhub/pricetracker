# Server Configuration
PORT=8000
HOST=127.0.0.1

# Scraper Configuration
# Set to False to run Chrome with visible window (recommended for Akamai/UC Mode testing)
HEADLESS=False

# Timeout in seconds
TIMEOUT=30

# Proxy Configuration (Webshare / Residential / Datacenter Proxy)
# Format: user:password@ip:port or ip:port
# Can be a single proxy or multiple comma-separated proxies for automatic rotation
# Example: PROXY_URL=ogzyxynt:jzc7hqe84lye@31.59.20.176:6754,ogzyxynt:jzc7hqe84lye@45.38.107.97:6014
PROXY_URL=
